# ─── Supabase (required) ───────────────────────────────────────────────
# VITE_* vars are inlined into the browser bundle. Only the URL and the
# anon key are public by design.
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side copies used by the API proxy functions (/api/nvidia, /api/modal-research,
# /api/transcribe) to verify user sessions. Set the same values in the Vercel env.
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── AI providers (server-side only — never VITE_*) ────────────────────
# NVIDIA (used by /api/nvidia proxy; the key never ships to the browser)
NVIDIA_API_KEY=your_nvidia_api_key

# OpenAI (used by /api/transcribe for voice notes)
OPENAI_API_KEY=your_openai_api_key

# Modal research (legacy /api/modal-research proxy)
MODAL_RESEARCH_API_KEY=your_modal_api_key

# ─── Market data (server-side only — never VITE_*) ─────────────────────
FMP_API_KEY=your_fmp_api_key
FINNHUB_API_KEY=your_finnhub_api_key

# ─── cTrader OpenAPI ───────────────────────────────────────────────────
# Client ID is a public OAuth identifier and may live in the browser.
VITE_CTRADER_CLIENT_ID=your_ctrader_client_id

# Server-only cTrader credentials (used by /api/ctrader/*). Do NOT use a VITE_* var
# for the secret on the server.
CTRADER_CLIENT_ID=your_ctrader_client_id
CTRADER_CLIENT_SECRET=your_ctrader_client_secret

# Optional: extra exact-match hosts allowed as cTrader OAuth redirect_uri
# (comma-separated). localhost / 127.0.0.1 / jfxjournal.site are allowed by default.
# CTRADER_ALLOWED_REDIRECT_HOSTS=

# ─── Vercel ────────────────────────────────────────────────────────────
VERCEL_TOKEN=your_vercel_token

# ─── Firehose (edge function env) ──────────────────────────────────────
FIREHOSE_API_KEY=your_firehose_api_key
