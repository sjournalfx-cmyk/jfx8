{
  "root": "Stack",
  "components": {
    "MetricCard": {
      "signature": "MetricCard(label: string, value: string, change?: string, tone?: \"positive\" | \"negative\" | \"neutral\")",
      "description": "A single KPI or metric with a label, value and optional change/tone."
    },
    "EquityChart": {
      "signature": "EquityChart(points: {date: string, value: number}[])",
      "description": "An area chart of account equity over time. Points must be ordered oldest to newest."
    },
    "TradeTable": {
      "signature": "TradeTable(rows: {pair: string, side: string, result: string, r: number | string, date: string, tradeId?: string}[])",
      "description": "A compact table of trades. Use for best/worst trades, recent trades, or filtered trade lists."
    },
    "RuleViolationList": {
      "signature": "RuleViolationList(items: {rule: string, count: number, lastSeen?: string}[])",
      "description": "A list of broken trading rules with occurrence counts. Use for discipline/compliance reviews."
    },
    "SessionBreakdown": {
      "signature": "SessionBreakdown(rows: {session: string, winRate: number, trades: number}[])",
      "description": "Win rate and trade count by trading session (London, New York, Asia, etc.)."
    },
    "ChecklistCard": {
      "signature": "ChecklistCard(items: {label: string, checked?: boolean}[])",
      "description": "A short pre-trade or review checklist with checked/unchecked items."
    },
    "ActionButtons": {
      "signature": "ActionButtons(buttons: {label: string, action: {type: \"open_url\", url: string} | {type: \"continue_conversation\", context?: string} | {type: string, params?: Record<string, any>}}[])",
      "description": "Navigation shortcuts rendered as buttons. Buttons may only open existing app screens; they never place, close or edit trades."
    },
    "Stack": {
      "signature": "Stack(children: (MetricCard | EquityChart | TradeTable | RuleViolationList | SessionBreakdown | ChecklistCard | ActionButtons)[])",
      "description": "Root vertical container. Pass the other components as its children, in display order."
    }
  },
  "actions": {
    "OpenJournal": {
      "signature": "OpenJournal()",
      "description": "Navigate to the trade journal (history)."
    },
    "OpenAnalytics": {
      "signature": "OpenAnalytics()",
      "description": "Navigate to analytics / weekly review."
    },
    "OpenLogTrade": {
      "signature": "OpenLogTrade()",
      "description": "Navigate to the log-trade form. It never submits or modifies a trade."
    },
    "OpenTradeDetail": {
      "signature": "OpenTradeDetail(tradeId: string)",
      "description": "Open an existing trade in the app. Requires the trade id from the journal context."
    }
  },
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "MetricCard": {
