      "ChecklistCard": {
        "$ref": "#/$defs/ChecklistCard"
      },
      "ActionButtons": {
        "$ref": "#/$defs/ActionButtons"
      },
      "Stack": {
        "$ref": "#/$defs/Stack"
      }
    },
    "required": [
      "MetricCard",
      "EquityChart",
      "TradeTable",
      "RuleViolationList",
      "SessionBreakdown",
      "ChecklistCard",
      "ActionButtons",
      "Stack"
